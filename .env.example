# Copy to .env and fill in. The plain .env file is gitignored.
#
# Where to find these: Supabase dashboard → your project → Settings (gear) → API
#   - Project URL                → EXPO_PUBLIC_SUPABASE_URL
#   - Project API keys → anon    → EXPO_PUBLIC_SUPABASE_ANON_KEY
# (New-format `sb_publishable_*` keys are equivalent to the legacy anon JWT.)
#
# The `EXPO_PUBLIC_` prefix is required — only those vars get inlined into the
# JS bundle at build time. See src/lib/env.ts.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
